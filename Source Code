#include <LiquidCrystal_I2C.h>

LiquidCrystal_I2C lcd(0x27, 16, 2);

const int joystickXPin = A0;
const int joystickYPin = A1;
const int joystickSwitchPin = 7;
const int bottomLedPin = 8;
const int rightLedPin = 9;
const int leftLedPin = 10;
const int topLedPin = 11;

void clearDirectionLeds() {
  digitalWrite(bottomLedPin, LOW);
  digitalWrite(rightLedPin, LOW);
  digitalWrite(leftLedPin, LOW);
  digitalWrite(topLedPin, LOW);
}

void showDirection(const char* direction, int ledPin) {
  clearDirectionLeds();
  digitalWrite(ledPin, HIGH);
  lcd.setCursor(0, 1);
  lcd.print("                ");
  lcd.setCursor(0, 1);
  lcd.print(direction);
}

void setup() {
  Serial.begin(9600);

  lcd.init();
  lcd.backlight();
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("DIRECTION");

  pinMode(joystickSwitchPin, INPUT_PULLUP);
  pinMode(bottomLedPin, OUTPUT);
  pinMode(rightLedPin, OUTPUT);
  pinMode(leftLedPin, OUTPUT);
  pinMode(topLedPin, OUTPUT);
  clearDirectionLeds();
}

void loop() {
  const int xValue = analogRead(joystickXPin);
  const int yValue = analogRead(joystickYPin);
  const int switchValue = digitalRead(joystickSwitchPin);

  Serial.print("X: ");
  Serial.println(xValue);
  Serial.print("Y: ");
  Serial.println(yValue);
  Serial.print("S: ");
  Serial.println(switchValue);

  if (yValue < 200) {
    showDirection("RIGHT", rightLedPin);
  } else if (yValue > 800) {
    showDirection("LEFT", leftLedPin);
  } else if (xValue <= 250) {
    showDirection("TOP", topLedPin);
  } else if (xValue > 700) {
    showDirection("BOTTOM", bottomLedPin);
  } else {
    clearDirectionLeds();
    lcd.setCursor(0, 1);
    lcd.print("                ");
    lcd.setCursor(0, 1);
    lcd.print("CENTER");
  }

  delay(100);
}